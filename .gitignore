# ---------------------------------------------------------------
# osu2tja — 上传 GitHub 时**不该**进仓库的东西
# 原则: 只传「你自己写的代码 + 对外文档」, 不传别人的作品、不传内部工作区。
# ---------------------------------------------------------------

# 内部工作区: 工作笔记 / 校验脚本 / 历史产物 / 音源缓存
.workbuddy/

# 校验脚本与它们的产物 (tmp/_golden.py、tmp/_test_*.py 等), 纯本地自检用
tmp/

# 手动拖拽上传用的快照副本 (内容与根目录文件重复, 避免重复入库)
_github上传/

# 内部研究笔记: 逆向报告 / OFFSET 与 SV 的对照推导 / 验收次序 / 大白话原理
# (作者自用, 结论已提炼进代码注释与 docs/, 原文不随仓库分发)
笔记/

# 前人写的旧版转换器 (来源与许可证不明): 只借鉴了它的 OFFSET 算法思路, 代码不分发
参考/

# 他人的 osu 谱面文件与歌曲名 (osu 社区作者的作品, 传上去等于再分发)
debug/

# 谱面与音频: 版权归原作者, 一律不进仓库
本家谱面/
*.mp3
*.ogg
*.wav
*.flac

# 图片 (谱面背景等); 将来确实要放截图进仓库时, 用 git add -f 强制加
*.jpg
*.jpeg
*.png
*.bmp

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
